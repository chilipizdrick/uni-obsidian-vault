#import "@preview/lilaq:0.5.0" as lq
#import "../lib.typ": *

Из урны, содержащей $M=5$ белых и $N=6$ черных шаров, случайным образом и без возвращения извлекается $m=5$ шаров. Случайная величина $xi$ — число белых шаров в выборке.

== Решение

Описанное распределение --- гипергеометрическое, функция плотности вероятности принимает вид: $ P(xi = k) = (binom(M, k) binom(N, m-k))/binom(T, m) $


Подставляя $k=0, ..., 5$ получим:

#align(center, table(
  columns: 7,
  $xi$, $0$, $1$, $2$, $3$, $4$, $5$,
  $P(xi)$, $0.01299$, $0.16234$, $0.4329$, $0.32468$, $0.06494$, $0.00216$,
  $F_xi (x)$, $0.01299$, $0.17533$, $0.60823$, $0.93291$, $0.99785$, $1$,
))

Для гипергеометрического распределения математическое ожидание и дисперсия принимают вид: $ ma xi = m M/T, \
di xi = (n(M/T)(1-M/T)(T-m))/(M-1), $ где $T = M+N$.

Тогда $ma xi = 5 dot 5/11 = 25/11 = 2.27273$, $di xi = (5 dot 5/11 dot (1- 5/11) dot (11-5))/(11-1) = 90/121 = 0.7438$, $sigma_xi = sqrt(di xi) = 0.86244$.

Для вычисления вероятности $P{|xi - ma xi| < sigma_xi}$ найдем значения $xi$, попадающие в интервал $(ma xi - sigma_xi, ma xi + sigma_xi)$. $((2.2727−0.8624, 2.2727+0.8624)) = (1.4103, 3.1351) in.rev 2,3$. Тогда вероятность $P{|xi - ma xi| < sigma_xi}$ равна $P(xi = 2) + P(xi = 3) = 0.4329+0.32468=0.75757$.

#{
  let x = range(0, 6)
  let y = (0.01299, 0.17533, 0.60823, 0.93291, 0.99785, 1)

  let diag = lq.diagram(
    title: [Функция распределения],
    ylabel: $F_xi (x)$,
    xlabel: $x$,
    width: 60%,
    height: 30%,
    lq.plot(x, y, smooth: true),
  )

  align(center, diag)
}
